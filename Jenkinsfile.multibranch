// Jenkinsfile for EC2 multi-branch pipeline
pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOY_TARGET', choices: ['current-instance', 'all-instances'], description: 'Deploy target')
        booleanParam(name: 'RUN_HEALTH_CHECK', defaultValue: true, description: 'Run health check')
    }

    stages {
        stage('Prepare') {
            steps {
                script {
                    env.BRANCH_TYPE = env.BRANCH_NAME.startsWith('feature/') ? 'feature' :
                                      env.BRANCH_NAME == 'ec2-development' ? 'development' :
                                      env.BRANCH_NAME == 'ec2-staging' ? 'staging' :
                                      env.BRANCH_NAME == 'main' ? 'production' : 'other'
                    env.INSTANCE_ID = sh(script: "bash ec2-info.sh | grep 'Instance ID' | cut -d' ' -f3", returnStdout: true).trim()
                }
                echo "Branch: ${env.BRANCH_NAME}"
                echo "Branch Type: ${env.BRANCH_TYPE}"
                echo "Instance ID: ${env.INSTANCE_ID}"
                echo "Deploy Target: ${params.DEPLOY_TARGET}"
            }
        }

        stage('Validate Scripts') {
            steps {
                sh '''
                    echo "=== Script Validation for ${BRANCH_TYPE} ==="
                    for script in *.sh; do
                        if [ -f "$script" ]; then
                            bash -n "$script" && echo "✓ $script" || echo "✗ $script"
                        fi
                    done
                '''
            }
        }

        stage('Test Scripts') {
            when {
                expression { params.RUN_HEALTH_CHECK == true }
            }
            parallel {
                stage('Syntax Tests') {
                    steps {
                        sh '''
                            echo "Running syntax tests..."
                            bash -n ec2-info.sh && echo "ec2-info.sh syntax OK"
                            bash -n ec2-health.sh && echo "ec2-health.sh syntax OK"
                        '''
                    }
                }
                stage('Functionality Tests') {
                    steps {
                        sh '''
                            echo "Running functionality tests..."
                            chmod +x *.sh
                            timeout 30 ./ec2-info.sh > /tmp/test-output.txt
                            echo "Test completed"
                        '''
                    }
                }
            }
        }

        stage('Deploy to Development') {
            when {
                anyOf {
                    branch 'ec2-development'
                    branch 'feature/*'
                }
            }
            steps {
                echo "Deploying to development environment"
                sh '''
                    mkdir -p /var/lib/jenkins/ec2-scripts/dev
                    cp *.sh /var/lib/jenkins/ec2-scripts/dev/
                    echo "Development deployment completed"
                '''
            }
        }

        stage('Deploy to Staging') {
            when {
                branch 'ec2-staging'
            }
            steps {
                echo "Deploying to staging environment"
                sh '''
                    mkdir -p /var/lib/jenkins/ec2-scripts/staging
                    cp *.sh /var/lib/jenkins/ec2-scripts/staging/
                    echo "Staging deployment completed"
                '''
            }
        }

        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                input message: 'Deploy to Production Instance?', ok: 'Deploy'
                echo "Deploying to production environment"
                sh '''
                    mkdir -p /var/lib/jenkins/ec2-scripts/prod
                    cp *.sh /var/lib/jenkins/ec2-scripts/prod/
                    chmod +x /var/lib/jenkins/ec2-scripts/prod/*.sh
                    echo "Production deployment completed on ${INSTANCE_ID}"
                '''
            }
        }
    }

    post {
        always {
            echo "EC2 Pipeline completed for branch: ${env.BRANCH_NAME}"
            archiveArtifacts artifacts: '*.sh', allowEmptyArchive: true
        }
        success {
            echo "✓ Pipeline succeeded on instance ${env.INSTANCE_ID}!"
        }
        failure {
            echo "✗ Pipeline failed on instance ${env.INSTANCE_ID}!"
        }
    }
}
